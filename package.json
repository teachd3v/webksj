{
  "name": "ksj-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ksj-db --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute ksj-db --local --file=./migration-backup/seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 execute ksj-db --remote --file=./migrations/0001_init.sql",
    "db:seed:remote": "wrangler d1 execute ksj-db --remote --file=./migration-backup/seed.sql",
    "db:aula:migrate:local": "wrangler d1 execute ksj-db --local --file=./migrations/0004_pinjam_aula.sql",
    "db:aula:seed:local": "wrangler d1 execute ksj-db --local --file=./migrations/seed_aula.sql",
    "db:aula:migrate:remote": "wrangler d1 execute ksj-db --remote --file=./migrations/0004_pinjam_aula.sql",
    "db:aula:seed:remote": "wrangler d1 execute ksj-db --remote --file=./migrations/seed_aula.sql",
    "db:aula:sync:sheets": "node scripts/migrate-aula-sheets.cjs",
    "sanity:pull": "node scripts/migrate-sanity.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/react": "^7.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "hono": "^4.7.0",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.151.3"
  }
}
