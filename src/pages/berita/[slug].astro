---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar';
import Footer from '@/components/Footer';
import { getDb, getNewsBySlug } from '@/lib/db';
import { Calendar, ArrowLeft } from 'lucide-react';

const { slug } = Astro.params;
const db = getDb(Astro.locals);
const newsItem = slug ? await getNewsBySlug(db, slug) : null;

if (!newsItem) {
    return Astro.redirect('/berita');
}

const cleanExcerpt = (newsItem.excerpt || '')
    .replace(/<[^>]*>?/gm, '')
    .replace(/\s+/g, ' ')
    .trim();

const metaDescription = cleanExcerpt 
    ? (cleanExcerpt.length > 155 ? `${cleanExcerpt.substring(0, 152)}...` : cleanExcerpt)
    : `Berita dan liputan kegiatan Kampung Silat Jampang: ${newsItem.title}.`;

const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: newsItem.title,
    description: metaDescription,
    image: newsItem.image ? [`https://kampungsilatjampang.id${newsItem.image}`] : ['https://kampungsilatjampang.id/images/logo.png'],
    datePublished: newsItem.date,
    dateModified: newsItem.date,
    author: {
        '@type': 'Organization',
        name: 'Redaksi Kampung Silat Jampang',
        url: 'https://kampungsilatjampang.id',
    },
    publisher: {
        '@type': 'Organization',
        name: 'Kampung Silat Jampang',
        url: 'https://kampungsilatjampang.id',
        logo: {
            '@type': 'ImageObject',
            url: 'https://kampungsilatjampang.id/images/logo.png',
        },
    },
    mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://kampungsilatjampang.id/berita/${newsItem.slug}`,
    },
};
---

<Layout
    title={`${newsItem.title} | Berita KSJ`}
    description={metaDescription}
    ogImage={newsItem.image}
    type="article"
    keywords={`Berita Silat, ${newsItem.title}, Kampung Silat Jampang, Kegiatan Silat Bogor`}
    schemaJson={articleSchema}
>
    <main class="min-h-screen bg-neutral-950 text-white pb-20">
        <Navbar client:load />

        <!-- Hero Header -->
        <div class="relative h-[60vh] w-full pt-20">
            <div class="absolute inset-0 bg-neutral-900">
                {newsItem.image ? (
                    <img
                        src={newsItem.image}
                        alt={newsItem.title}
                        class="w-full h-full object-cover opacity-40"
                    />
                ) : (
                    <div class="w-full h-full bg-neutral-800 flex items-center justify-center">
                        <span class="text-neutral-600 text-6xl italic">KSJ News</span>
                    </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent" />
            </div>

            <div class="relative z-10 container mx-auto px-6 h-full flex flex-col justify-end pb-12">
                <a
                    href="/berita"
                    class="inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 transition-colors mb-8 group"
                >
                    <ArrowLeft size={20} className="group-hover:-translate-x-1 transition-transform" />
                    Kembali ke Berita
                </a>

                <div class="flex items-center gap-3 text-gray-400 mb-4 uppercase tracking-widest text-sm font-bold">
                    <Calendar size={16} className="text-amber-500" />
                    {newsItem.date}
                </div>

                <h1 class="text-4xl md:text-6xl font-bold font-display max-w-4xl tracking-tight leading-tight">
                    {newsItem.title}
                </h1>
            </div>
        </div>

        <!-- Content Section -->
        <div class="container mx-auto px-6 mt-16">
            <article class="max-w-3xl mx-auto">
                <div class="text-gray-300 text-lg leading-relaxed">
                    {newsItem.excerpt && (
                        <p class="text-xl text-amber-500/80 font-medium mb-12 italic border-l-4 border-amber-500 pl-6 leading-relaxed">
                            {newsItem.excerpt}
                        </p>
                    )}

                    <div class="rich-content">
                        {newsItem.content ? (
                            <Fragment set:html={newsItem.content} />
                        ) : (
                            <p>Isi berita sedang dalam proses kurasi...</p>
                        )}
                    </div>
                </div>
            </article>
        </div>

        <Footer client:visible />
    </main>
</Layout>
