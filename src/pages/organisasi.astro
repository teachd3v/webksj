---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar';
import Footer from '@/components/Footer';
import OrganisasiClient from '@/components/OrganisasiClient';
import { getDb, getOrganisasi } from '@/lib/db';
import { ArrowLeft } from 'lucide-react';

const db = getDb(Astro.locals);
const displayData = await getOrganisasi(db);
---

<Layout
    title="Struktur Pengurus & Organisasi | Kampung Silat Jampang"
    description="Struktur pengurus inti dan bidang kelembagaan Kampung Silat Jampang (KSJ) periode aktif dalam melestarikan pencak silat nusantara."
    keywords="Pengurus Kampung Silat Jampang, Struktur KSJ, Dewan Pembina Silat, Tokoh Silat Bogor"
>
    <main class="min-h-screen bg-neutral-950 text-white">
        <Navbar client:load />

        <div class="pt-32 pb-20">
            <div class="container mx-auto px-6">
                <a
                    href="/#about"
                    class="inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 transition-colors mb-12 group"
                >
                    <ArrowLeft size={20} className="group-hover:-translate-x-1 transition-transform" />
                    Kembali ke Tentang Kami
                </a>

                <div class="text-center mb-20">
                    <h1 class="text-4xl md:text-6xl font-bold font-display mb-6 tracking-tight">
                        {displayData.title}
                    </h1>
                    <div class="w-24 h-1 bg-amber-500 mx-auto rounded-full" />
                </div>

                <OrganisasiClient
                    client:load
                    pengurusInti={displayData.pengurusInti || []}
                    bidangList={displayData.bidangList || []}
                />
            </div>
        </div>

        <Footer client:visible />
    </main>
</Layout>
