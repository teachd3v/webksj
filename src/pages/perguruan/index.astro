---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar';
import Footer from '@/components/Footer';
import DirectoryClient from '@/components/DirectoryClient';
import { getDb, getAllPerguruan } from '@/lib/db';

const db = getDb(Astro.locals);
const schools = await getAllPerguruan(db);
---

<Layout
    title="Direktori 59+ Perguruan Pencak Silat | Kampung Silat Jampang"
    description="Temukan direktori lengkap 59+ perguruan pencak silat nusantara (Cimande, Beksi, Sera, Syahbandar, dll) yang tergabung dalam Kampung Silat Jampang."
    keywords="Direktori Perguruan Silat, Perguruan Silat Jawa Barat, Aliran Silat Cimande, Beksi, Sera, Syahbandar, KSJ Bogor"
>
    <main class="min-h-screen bg-neutral-900 text-neutral-50">
        <Navbar client:load />
        <section class="pt-32 pb-24">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h1 class="text-4xl md:text-5xl font-bold mb-4 font-display text-white">
                        Direktori <span class="text-amber-500">Perguruan</span>
                    </h1>
                    <p class="mt-4 text-gray-400 max-w-2xl mx-auto text-lg">
                        Daftar lengkap perguruan silat yang tergabung dalam ekosistem KSJ.
                    </p>
                </div>
                <DirectoryClient client:load schools={schools} />
            </div>
        </section>
        <Footer client:visible />
    </main>
</Layout>
